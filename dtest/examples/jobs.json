{
  "name": "nightly-virtualization-validation",
  "defaults": { "timeout_s": 300, "retries": 1 },
  "tasks": [
    {
      "name": "host-readiness",
      "argv": ["/opt/kvm-validation-suite/bin/platcheck", "--json"],
      "retries": 0
    },
    {
      "name": "vm-lifecycle-and-guest-checks",
      "argv": ["/opt/kvm-validation-suite/bin/vmtest", "--image", "/var/lib/vmtest/base.qcow2",
               "--junit", "/tmp/vmtest.xml"],
      "requires": ["kvm=true"],
      "timeout_s": 1800,
      "retries": 0
    },
    {
      "name": "vm-boot-destroy-soak",
      "argv": ["/opt/kvm-validation-suite/bin/vmtest", "--image", "/var/lib/vmtest/base.qcow2",
               "--filter", "stress.", "--iterations", "20"],
      "requires": ["kvm=true"],
      "timeout_s": 7200,
      "retries": 0
    }
  ]
}
