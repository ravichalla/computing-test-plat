//
// add_one(uint32_t* data, uint32_t n): data[i] += 1 for i < n.
// Hand-written PTX used by the Driver API test (module load + cuLaunchKernel).
// Target sm_52 PTX is JIT-compiled by the driver for whatever GPU is installed.
//
.version 7.0
.target sm_52
.address_size 64

.visible .entry add_one(
    .param .u64 data_param,
    .param .u32 n_param
)
{
    .reg .pred  %p<2>;
    .reg .b32   %r<8>;
    .reg .b64   %rd<6>;

    ld.param.u64    %rd1, [data_param];
    ld.param.u32    %r1, [n_param];

    mov.u32         %r2, %ctaid.x;
    mov.u32         %r3, %ntid.x;
    mov.u32         %r4, %tid.x;
    mad.lo.s32      %r5, %r2, %r3, %r4;      // global index

    setp.ge.u32     %p1, %r5, %r1;
    @%p1 bra        DONE;

    cvta.to.global.u64  %rd2, %rd1;
    mul.wide.u32    %rd3, %r5, 4;
    add.s64         %rd4, %rd2, %rd3;
    ld.global.u32   %r6, [%rd4];
    add.s32         %r7, %r6, 1;
    st.global.u32   [%rd4], %r7;

DONE:
    ret;
}
